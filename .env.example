# Copy to .env and fill in.

# Required — the constrained-choice policy will not run without this.
TYPESAFE_API_KEY=

# Text helper key(s). Set the one that matches TEXT_MODEL below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which text model the run should use. Leave unset to fall back to the
# registry default (haiku-4-5). Valid values right now:
#   haiku-4-5       (Anthropic)
#   gpt-4o          (OpenAI)
#   gpt-4o-mini     (OpenAI)
#   gpt-4.1         (OpenAI)
#   gpt-4.1-mini    (OpenAI)
#   gpt-4.1-nano    (OpenAI)
#   gpt-5.6-luna    (OpenAI)
#   gpt-5.6-sol     (OpenAI)
#   gpt-5.6-terra   (OpenAI)
#   gpt-6-astra     (OpenAI)
TEXT_MODEL=

# Optional
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
AGENT_URL=http://127.0.0.1:8787
# Set to 1 during development to auto-reload the Python server on code
# changes. Leave unset for real runs (a reload kills the live browser tab).
AGENT_RELOAD=
# Set to 1 when the machine has no display (headless server, some SSH
# sessions). Default is headed so you can watch the tab.
AGENT_HEADLESS=
# Persistent Chromium profile. Sites see returning-user cookies across runs,
# which sharply reduces bot-check hits. Default is ~/.cache/agent/profile.
# Set to `none` to disable persistence and get a fresh profile every run.
AGENT_PROFILE_DIR=
# Use your installed Chrome instead of the bundled Chromium (fingerprint is
# closer to a real user). Valid values on the host: `chrome`, `chrome-beta`,
# `msedge`, or unset for bundled Chromium.
AGENT_CHROME_CHANNEL=
# BEST anti-bot posture: attach to your already-running Chrome via CDP.
# Same trick the old code used — inherits real cookies, sign-ins, and
# fingerprint from a browser you started yourself.
# Setup: launch Chrome with a debugging port:
#   google-chrome --remote-debugging-port=9222 --user-data-dir="$HOME/.config/google-chrome"
# then set AGENT_CDP_URL below. The agent opens a new tab in that browser.
# `auto` reads the port from Chrome's DevToolsActivePort file (Chrome's
# built-in remote-debugging switch, chrome://inspect/#remote-debugging).
AGENT_CDP_URL=
# Run in this Chrome profile, by its display name; the agent then sees only
# its own tab. Optional overrides: AGENT_CHROME_USER_DATA_DIR, AGENT_CHROME_BINARY.
AGENT_CHROME_PROFILE=
# 1 closes the run's tab when it ends; unset leaves it open to show the result.
AGENT_CLOSE_TAB=
# Seconds a run waits for you to do a site's human check (press and hold,
# "verify you are human") in the Chrome window before it stops. Unset: 300.
AGENT_CAPTCHA_WAIT_S=
# Where runs keep what they learned (moves, products, finished plans). Unset:
# ~/.cache/agent/memory. "off" turns memory off.
AGENT_MEMORY_DIR=

# Region: an ISO country code (CA, ...). Sends global retailers to that
# country's storefront (walmart.com -> walmart.ca). Unset: URLs stay as given.
AGENT_REGION=
# IANA time zone for a launched browser (America/Toronto, ...). Unset: the
# machine's own. An attached Chrome always keeps its own.
AGENT_TIMEZONE=

# E2E scripts: the DoorDash Chipotle store to start on. Unset: DoorDash's home
# page, where the agent searches for the nearest store itself.
E2E_CHIPOTLE_URL=
